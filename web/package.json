{
  "name": "syndica-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "gen": "openapi-typescript ../docs/reference/openapi.json -o src/generated/openapi.ts && node scripts/gen-events.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern src e2e",
    "build": "vite build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  }
}
